{
  "name": "Business Member",
  "module": "Business",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "format:BM-.#####.",
  "title_field": "person_name",
  "search_fields": "person_name,email,business",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "is_tree": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "business",
      "fieldtype": "Link",
      "label": "Business",
      "options": "Business",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "User",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "person_name",
      "fieldtype": "Data",
      "label": "Person Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "designation",
      "fieldtype": "Data",
      "label": "Designation"
    },
    {
      "fieldname": "role",
      "fieldtype": "Select",
      "label": "Role",
      "reqd": 1,
      "options": "Owner\nManager\nMember\nMarketing\nCRM User",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email",
      "options": "Email",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Phone",
      "options": "Phone"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Active",
      "options": "Active\nInactive\nInvited\nSuspended",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "is_owner",
      "fieldtype": "Check",
      "label": "Is Owner",
      "default": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "joined_on",
      "fieldtype": "Date",
      "label": "Joined On"
    }
  ],
  "permissions": [
    {
      "role": "OSDuo Business Owner",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    },
    {
      "role": "OSDuo Business Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    },
    {
      "role": "OSDuo System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    }
  ]
}