{
  "name": "Business",
  "module": "Business",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "By \"Series\" field",
  "autoname": "naming_series:",
  "title_field": "business_name",
  "search_fields": "business_name,slug,industry",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "is_tree": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "default": "BIZ-.#####",
      "options": "BIZ-.#####",
      "reqd": 1,
      "set_only_once": 1
    },
    {
      "fieldname": "business_name",
      "fieldtype": "Data",
      "label": "Business Name",
      "reqd": 1,
      "unique": 0,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "legal_name",
      "fieldtype": "Data",
      "label": "Legal Name",
      "reqd": 0
    },
    {
      "fieldname": "slug",
      "fieldtype": "Data",
      "label": "Public Slug",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "Unique identifier for public URLs. Only lowercase letters, numbers, and hyphens."
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Draft",
      "options": "Draft\nPublished\nSuspended",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "owner_user",
      "fieldtype": "Link",
      "label": "Business Owner",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "industry",
      "fieldtype": "Data",
      "label": "Industry",
      "reqd": 0
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description"
    },
    {
      "fieldname": "logo",
      "fieldtype": "Attach Image",
      "label": "Logo"
    },
    {
      "fieldname": "cover_image",
      "fieldtype": "Attach Image",
      "label": "Cover Image"
    },
    {
      "fieldname": "section_contact",
      "fieldtype": "Section Break",
      "label": "Contact Information"
    },
    {
      "fieldname": "website",
      "fieldtype": "Data",
      "label": "Website",
      "options": "URL"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Business Email",
      "options": "Email"
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Business Phone",
      "options": "Phone"
    },
    {
      "fieldname": "whatsapp",
      "fieldtype": "Data",
      "label": "WhatsApp",
      "options": "Phone"
    },
    {
      "fieldname": "column_break_contact",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "address",
      "fieldtype": "Small Text",
      "label": "Address"
    },
    {
      "fieldname": "city",
      "fieldtype": "Data",
      "label": "City"
    },
    {
      "fieldname": "state",
      "fieldtype": "Data",
      "label": "State"
    },
    {
      "fieldname": "country",
      "fieldtype": "Link",
      "label": "Country",
      "options": "Country"
    },
    {
      "fieldname": "postal_code",
      "fieldtype": "Data",
      "label": "Postal Code"
    },
    {
      "fieldname": "timezone",
      "fieldtype": "Select",
      "label": "Time Zone",
      "options": "Asia/Kolkata\nAmerica/New_York\nEurope/London\nAmerica/Los_Angeles\nAsia/Dubai\nAsia/Singapore\nAustralia/Sydney"
    },
    {
      "fieldname": "section_branding",
      "fieldtype": "Section Break",
      "label": "Branding & Theme"
    },
    {
      "fieldname": "default_theme",
      "fieldtype": "Link",
      "label": "Default Theme",
      "options": "Theme"
    },
    {
      "fieldname": "public_profile_enabled",
      "fieldtype": "Check",
      "label": "Public Profile Enabled",
      "default": 1
    },
    {
      "fieldname": "column_break_branding",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "seo_title",
      "fieldtype": "Data",
      "label": "SEO Title",
      "description": "Title for search engine optimization"
    },
    {
      "fieldname": "seo_description",
      "fieldtype": "Small Text",
      "label": "SEO Description",
      "description": "Description for search engine optimization"
    },
    {
      "fieldname": "section_social",
      "fieldtype": "Section Break",
      "label": "Social Links"
    },
    {
      "fieldname": "social_links",
      "fieldtype": "Table",
      "label": "Social Links",
      "options": "Business Social Link"
    },
    {
      "fieldname": "section_hours",
      "fieldtype": "Section Break",
      "label": "Business Hours"
    },
    {
      "fieldname": "business_hours",
      "fieldtype": "Table",
      "label": "Business Hours",
      "options": "Business Hour"
    }
  ],
