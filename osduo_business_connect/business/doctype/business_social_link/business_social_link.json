{
    "name": "Business Social Link",
    "module": "Business",
    "doctype": "DocType",
    "document_type": "Document",
    "engine": "InnoDB",
    "istable": 1,
    "fields": [
        {
            "fieldname": "platform",
            "fieldtype": "Select",
            "label": "Platform",
            "reqd": 1,
            "options": "Facebook\nInstagram\nLinkedIn\nX\nYouTube\nTelegram\nWebsite\nPortfolio\nOther",
            "in_list_view": 1
        },
        {
            "fieldname": "url",
            "fieldtype": "Data",
            "label": "URL",
            "reqd": 1,
            "options": "URL",
            "in_list_view": 1,
            "description": "Facebook: https://facebook.com/page | Instagram: https://instagram.com/handle | LinkedIn: https://linkedin.com/in/profile | X: https://x.com/handle | YouTube: https://youtube.com/@channel | Telegram: https://t.me/handle | Website: https://your-site.com | Portfolio: https://your-portfolio.com"
        },
        {
            "fieldname": "icon_class",
            "fieldtype": "Data",
            "label": "Icon Class",
            "hidden": 1,
            "read_only": 1
        },
        {
            "fieldname": "enabled",
            "fieldtype": "Check",
            "label": "Enabled",
            "default": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "sort_order",
            "fieldtype": "Int",
            "label": "Sort Order"
        }
    ],
    "permissions": []
}
