{
 "name": "Contact Exchange",
 "module": "Card",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "title_field": "recipient_name",
 "search_fields": "recipient_name,recipient_phone,recipient_email,recipient_company",
 "is_submittable": 0,
 "issingle": 0,
 "istable": 0,
 "is_tree": 0,
 "track_changes": 1,
 "allow_rename": 0,
 "sort_field": "exchanged_at",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Naming Series",
   "default": "CE-.#####",
   "options": "CE-.#####",
   "reqd": 1,
   "set_only_once": 1
  },
  {
   "fieldname": "business",
   "fieldtype": "Link",
   "label": "Business",
   "options": "Business",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_shared",
   "fieldtype": "Section Break",
   "label": "What Was Shared"
  },
  {
   "fieldname": "card",
   "fieldtype": "Link",
   "label": "Digital Card",
   "options": "Digital Card"
  },
  {
   "fieldname": "column_break_shared",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "product",
   "fieldtype": "Link",
   "label": "Product",
   "options": "Showcase Product"
  },
  {
   "fieldname": "service",
   "fieldtype": "Link",
   "label": "Service",
   "options": "Showcase Service"
  },
  {
   "fieldname": "section_recipient",
   "fieldtype": "Section Break",
   "label": "Recipient"
  },
  {
   "fieldname": "recipient_name",
   "fieldtype": "Data",
   "label": "Recipient Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "recipient_company",
   "fieldtype": "Data",
   "label": "Company"
  },
  {
   "fieldname": "column_break_recipient",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "recipient_phone",
   "fieldtype": "Data",
   "label": "Mobile Number",
   "options": "Phone",
   "in_list_view": 1
  },
  {
   "fieldname": "recipient_email",
   "fieldtype": "Data",
   "label": "Email Address",
   "options": "Email"
  },
  {
   "fieldname": "section_context",
   "fieldtype": "Section Break",
   "label": "Context"
  },
  {
   "fieldname": "channel",
   "fieldtype": "Select",
   "label": "Channel",
   "options": "WhatsApp\nSMS\nEmail\nIn-person",
   "default": "WhatsApp",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "event_name",
   "fieldtype": "Data",
   "label": "Event / Meeting"
  },
  {
   "fieldname": "column_break_context",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "exchanged_at",
   "fieldtype": "Datetime",
   "label": "Exchanged At",
   "default": "Now",
   "in_list_view": 1
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "Shared By",
   "options": "User",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "label": "Business Member",
   "options": "Business Member",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "section_status",
   "fieldtype": "Section Break",
   "label": "Follow-up"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "New\nContacted\nQualified\nConverted\nArchived",
   "default": "New",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "linked_enquiry",
   "fieldtype": "Link",
   "label": "Linked Enquiry",
   "options": "Enquiry",
   "read_only": 1,
   "description": "Created automatically from this exchange; the CRM Lead is linked on the Enquiry."
  }
 ],
 "permissions": [
  {
   "role": "BC Business Owner",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "user_permission": 1
  },
  {
   "role": "BC Business Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "user_permission": 1
  },
  {
   "role": "BC Business Member",
   "read": 1,
   "write": 0,
   "create": 1,
   "delete": 0,
   "report": 0,
   "export": 0,
   "print": 0,
   "email": 0,
   "share": 0,
   "user_permission": 0
  },
  {
   "role": "BC Marketing Manager",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 0,
   "email": 0,
   "share": 0,
   "user_permission": 0
  },
  {
   "role": "BC System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "user_permission": 1
  }
 ],
 "links": []
}
