{
  "name": "Digital Card",
  "module": "Card",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "By \"Series\" field",
  "autoname": "naming_series:",
  "title_field": "display_name",
  "search_fields": "display_name,slug,business",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "is_tree": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "default": "CARD-.#####",
      "options": "CARD-.#####, CARD-.YYYY.-.#####, CARD-.YYYY.-.MM.-.#####",
      "reqd": 1,
      "set_only_once": 1
    },
    {
      "fieldname": "business",
      "fieldtype": "Link",
      "label": "Business",
      "options": "Business",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "member",
      "fieldtype": "Link",
      "label": "Member",
      "options": "Business Member",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "display_name",
      "fieldtype": "Data",
      "label": "Display Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "slug",
      "fieldtype": "Data",
      "label": "Public Slug",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "Unique identifier for public URLs. Only lowercase letters, numbers, and hyphens."
    },
    {
      "fieldname": "designation",
      "fieldtype": "Data",
      "label": "Designation"
    },
    {
      "fieldname": "profile_image",
      "fieldtype": "Attach Image",
      "label": "Profile Image"
    },
    {
      "fieldname": "bio",
      "fieldtype": "Small Text",
      "label": "Bio"
    },
    {
      "fieldname": "section_contact",
      "fieldtype": "Section Break",
      "label": "Contact Information"
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Phone",
      "options": "Phone"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email",
      "options": "Email"
    },
    {
      "fieldname": "whatsapp",
      "fieldtype": "Data",
      "label": "WhatsApp",
      "options": "Phone"
    },
    {
      "fieldname": "website",
      "fieldtype": "Data",
      "label": "Website",
      "options": "URL"
    },
    {
      "fieldname": "section_links",
      "fieldtype": "Section Break",
      "label": "Social Links"
    },
    {
      "fieldname": "links",
      "fieldtype": "Table",
      "label": "Links",
      "options": "Digital Card Link"
    },
    {
      "fieldname": "section_settings",
      "fieldtype": "Section Break",
      "label": "Settings"
    },
    {
      "fieldname": "theme",
      "fieldtype": "Link",
      "label": "Theme",
      "options": "Theme"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Draft",
      "options": "Draft\nPublished\nUnpublished\nSuspended",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_settings",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "public_profile_enabled",
      "fieldtype": "Check",
      "label": "Public Profile Enabled",
      "default": 1
    },
    {
      "fieldname": "qr_enabled",
      "fieldtype": "Check",
      "label": "QR Enabled",
      "default": 1
    },
    {
      "fieldname": "vcard_enabled",
      "fieldtype": "Check",
      "label": "vCard Enabled",
      "default": 1
    },
    {
      "fieldname": "show_business",
      "fieldtype": "Check",
      "label": "Show Business",
      "default": 1
    },
    {
      "fieldname": "sort_order",
      "fieldtype": "Int",
      "label": "Sort Order"
    },
    {
      "fieldname": "section_computed",
      "fieldtype": "Section Break",
      "label": "Computed Fields"
    },
    {
      "fieldname": "public_url",
      "fieldtype": "Data",
      "label": "Public URL",
      "read_only": 1,
      "description": "Generated public URL for this card"
    },
    {
      "fieldname": "qr_image",
      "fieldtype": "Attach Image",
      "label": "QR Code Image",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "OSDuo Business Owner",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    },
    {
      "role": "OSDuo Business Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    },
    {
      "role": "OSDuo Business Member",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 0,
      "export": 0,
      "import": 0,
      "print": 0,
      "email": 0,
      "share": 0,
      "user_permission": 0
    },
    {
      "role": "OSDuo System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    }
  ]
}