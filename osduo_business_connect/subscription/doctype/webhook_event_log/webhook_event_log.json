{
  "name": "Webhook Event Log",
  "module": "Subscription",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "sort_field": "received_on",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Naming Series", "options": "WHEVT-.YYYY.-", "default": "WHEVT-.YYYY.-", "reqd": 1, "set_only_once": 1, "hidden": 1},
    {"fieldname": "event_id", "fieldtype": "Data", "label": "Event ID", "in_list_view": 1},
    {"fieldname": "source", "fieldtype": "Data", "label": "Source", "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Received\nIgnored\nProcessed\nFailed", "default": "Received", "in_list_view": 1},
    {"fieldname": "payload", "fieldtype": "Code", "label": "Payload"},
    {"fieldname": "received_on", "fieldtype": "Datetime", "label": "Received On", "default": "Now", "read_only": 1}
  ],
  "permissions": [
    {
      "role": "BC Subscription Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1,
      "report": 1, "export": 1
    }
  ]
}
