{
  "name": "Add-on Master",
  "module": "Subscription",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "By \"Field\" value",
  "autoname": "field:code",
  "title_field": "add_on_name",
  "search_fields": "code,add_on_name",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "allow_import": 0,
  "fields": [
    {"fieldname": "code", "fieldtype": "Data", "label": "Code", "reqd": 1, "unique": 1, "set_only_once": 1, "in_list_view": 1},
    {"fieldname": "add_on_name", "fieldtype": "Data", "label": "Add-on Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "billing_type", "fieldtype": "Select", "label": "Billing Type", "options": "Annual\nActual Cost", "default": "Annual", "reqd": 1, "in_list_view": 1},
    {"fieldname": "price", "fieldtype": "Currency", "label": "List Price", "default": "0"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1"},
    {"fieldname": "section_applicability", "fieldtype": "Section Break", "label": "Applicability"},
    {"fieldname": "applies_to_all_plans", "fieldtype": "Check", "label": "Applies to All Plans", "default": "1"},
    {"fieldname": "applicable_plans", "fieldtype": "Table", "label": "Applicable Plans", "options": "Add-on Applicable Plan", "depends_on": "!applies_to_all_plans"},
    {"fieldname": "section_details", "fieldtype": "Section Break", "label": "Details"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"}
  ],
  "permissions": [
    {
      "role": "BC Subscription Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1,
      "report": 1, "export": 1, "import": 1, "print": 1, "email": 1, "share": 1
    },
    {
      "role": "BC System Manager",
      "read": 1
    },
    {
      "role": "BC Business Owner",
      "read": 1
    },
    {
      "role": "BC Business Manager",
      "read": 1
    }
  ]
}
