{
  "name": "SaaS Plan",
  "module": "Subscription",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "By \"Field\" value",
  "autoname": "field:plan_code",
  "title_field": "plan_name",
  "search_fields": "plan_code,plan_name",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "allow_import": 0,
  "sort_field": "sort_order",
  "sort_order": "ASC",
  "fields": [
    {"fieldname": "plan_code", "fieldtype": "Data", "label": "Plan Code", "reqd": 1, "unique": 1, "set_only_once": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "plan_name", "fieldtype": "Data", "label": "Plan Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "section_pricing", "fieldtype": "Section Break", "label": "Pricing & Limits"},
    {"fieldname": "price_per_seat_per_year", "fieldtype": "Currency", "label": "Price per User per Year", "reqd": 1},
    {"fieldname": "min_seats", "fieldtype": "Int", "label": "Minimum Billed Seats", "reqd": 1, "default": "1"},
    {"fieldname": "min_annual_commitment", "fieldtype": "Currency", "label": "Minimum Annual Commitment", "read_only": 1},
    {"fieldname": "billing_cycle", "fieldtype": "Select", "label": "Billing Cycle", "options": "Annual", "default": "Annual", "read_only": 1},
    {"fieldname": "column_break_pricing", "fieldtype": "Column Break"},
    {"fieldname": "max_businesses", "fieldtype": "Int", "label": "Max Business Profiles", "reqd": 1, "default": "1", "description": "Use -1 for unlimited (reserved for future plans)."},
    {"fieldname": "included_domain_mappings", "fieldtype": "Int", "label": "Included Domain Mappings", "default": "0"},
    {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sort Order", "default": "0"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1"},
    {"fieldname": "section_base_features", "fieldtype": "Section Break", "label": "Base Features (all plans)"},
    {"fieldname": "digital_business_card", "fieldtype": "Check", "label": "Digital Business Card", "default": "1"},
    {"fieldname": "business_profile", "fieldtype": "Check", "label": "Business Profile", "default": "1"},
    {"fieldname": "qr_sharing", "fieldtype": "Check", "label": "QR Code Sharing", "default": "1"},
    {"fieldname": "product_showcase", "fieldtype": "Check", "label": "Product Showcase", "default": "1"},
    {"fieldname": "services_showcase", "fieldtype": "Check", "label": "Services Showcase", "default": "1"},
    {"fieldname": "column_break_base", "fieldtype": "Column Break"},
    {"fieldname": "lead_capture", "fieldtype": "Check", "label": "Lead Capture", "default": "1"},
    {"fieldname": "contact_management", "fieldtype": "Check", "label": "Contact Management", "default": "1"},
    {"fieldname": "mobile_pwa", "fieldtype": "Check", "label": "Mobile App (PWA)", "default": "1"},
    {"fieldname": "social_media_integration", "fieldtype": "Check", "label": "Social Media Integration", "default": "1"},
    {"fieldname": "nfc_integration", "fieldtype": "Check", "label": "NFC Integration (digital)", "default": "1"},
    {"fieldname": "section_growth_features", "fieldtype": "Section Break", "label": "Growth Features"},
    {"fieldname": "multiple_business_profiles", "fieldtype": "Check", "label": "Multiple Business Profiles"},
    {"fieldname": "team_management", "fieldtype": "Check", "label": "Team Management"},
    {"fieldname": "crm_access", "fieldtype": "Check", "label": "CRM Access"},
    {"fieldname": "column_break_growth", "fieldtype": "Column Break"},
    {"fieldname": "analytics", "fieldtype": "Check", "label": "Analytics"},
    {"fieldname": "import_export", "fieldtype": "Check", "label": "Import / Export"},
    {"fieldname": "section_advanced_admin", "fieldtype": "Section Break", "label": "Advanced Administration (Enterprise only)"},
    {"fieldname": "crm_full_control", "fieldtype": "Check", "label": "Full CRM Control"},
    {"fieldname": "email_configuration", "fieldtype": "Check", "label": "Email Configuration"},
    {"fieldname": "whatsapp_configuration", "fieldtype": "Check", "label": "WhatsApp Configuration"},
    {"fieldname": "column_break_advanced", "fieldtype": "Column Break"},
    {"fieldname": "advanced_admin", "fieldtype": "Check", "label": "Advanced Administration (master flag)"},
    {"fieldname": "section_domains", "fieldtype": "Section Break", "label": "Domains"},
    {"fieldname": "domain_mapping_price", "fieldtype": "Currency", "label": "Extra Domain Mapping Price", "default": "5999"},
    {"fieldname": "domain_registration_billing", "fieldtype": "Select", "label": "Registration / Renewal Billing", "options": "Actual Cost", "default": "Actual Cost", "read_only": 1}
  ],
  "permissions": []
}
