{
  "name": "Engagement Event",
  "module": "Analytics",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "By \"Series\" field",
  "autoname": "naming_series:",
  "title_field": "event_type",
  "search_fields": "event_type,business",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "is_tree": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "sort_field": "event_time",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "default": "EVT-.#####",
      "options": "EVT-.#####",
      "reqd": 1,
      "set_only_once": 1
    },
    {
      "fieldname": "business",
      "fieldtype": "Link",
      "label": "Business",
      "options": "Business",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "event_type",
      "fieldtype": "Select",
      "label": "Event Type",
      "reqd": 1,
      "options": "profile_view\ncard_view\nqr_landing\nproduct_view\nservice_view\nphone_click\nemail_click\nwhatsapp_click\nwebsite_click\nbrochure_download\nenquiry_submitted\nshared_link_open\ncontact_exchanged",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "event_time",
      "fieldtype": "Datetime",
      "label": "Event Time",
      "reqd": 1,
      "default": "Now",
      "in_list_view": 1
    },
    {
      "fieldname": "section_visitor",
      "fieldtype": "Section Break",
      "label": "Visitor"
    },
    {
      "fieldname": "visitor_type",
      "fieldtype": "Select",
      "label": "Visitor Type",
      "options": "Guest\nOwner\nMember\nOther User\nUnknown",
      "default": "Unknown",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_visitor",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "visitor_user",
      "fieldtype": "Data",
      "label": "Visitor User",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "section_reference",
      "fieldtype": "Section Break",
      "label": "Reference"
    },
    {
      "fieldname": "session_id",
      "fieldtype": "Data",
      "label": "Session ID"
    },
    {
      "fieldname": "card",
      "fieldtype": "Link",
      "label": "Digital Card",
      "options": "Digital Card"
    },
    {
      "fieldname": "column_break_reference",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "product",
      "fieldtype": "Link",
      "label": "Product",
      "options": "Showcase Product"
    },
    {
      "fieldname": "service",
      "fieldtype": "Link",
      "label": "Service",
      "options": "Showcase Service"
    },
    {
      "fieldname": "section_context",
      "fieldtype": "Section Break",
      "label": "Context"
    },
    {
      "fieldname": "campaign",
      "fieldtype": "Data",
      "label": "Campaign"
    },
    {
      "fieldname": "shared_by",
      "fieldtype": "Data",
      "label": "Shared By",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "landing_url",
      "fieldtype": "Data",
      "label": "Landing URL",
      "options": "URL"
    },
    {
      "fieldname": "column_break_context",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "referrer",
      "fieldtype": "Data",
      "label": "Referrer",
      "options": "URL"
    },
    {
      "fieldname": "section_device",
      "fieldtype": "Section Break",
      "label": "Device Information"
    },
    {
      "fieldname": "device_type",
      "fieldtype": "Select",
      "label": "Device Type",
      "options": "Desktop\nMobile\nTablet\nUnknown"
    },
    {
      "fieldname": "browser",
      "fieldtype": "Data",
      "label": "Browser"
    },
    {
      "fieldname": "column_break_device",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "country",
      "fieldtype": "Data",
      "label": "Country"
    },
    {
      "fieldname": "city",
      "fieldtype": "Data",
      "label": "City"
    }
  ],
  "permissions": [
    {
      "role": "BC Business Owner",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 0,
      "email": 0,
      "share": 0,
      "user_permission": 0
    },
    {
      "role": "BC Business Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 0,
      "email": 0,
      "share": 0,
      "user_permission": 0
    },
    {
      "role": "BC Marketing Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 0,
      "email": 0,
      "share": 0,
      "user_permission": 0
    },
    {
      "role": "BC System Manager",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    }
  ]
}