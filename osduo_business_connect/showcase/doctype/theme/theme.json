{
  "name": "Theme",
  "module": "Showcase",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "By \"Series\" field",
  "autoname": "naming_series:",
  "title_field": "theme_name",
  "search_fields": "theme_name,business,template",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "is_tree": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "default": "THEME-.#####",
      "options": "THEME-.#####",
      "reqd": 1,
      "set_only_once": 1,
      "hidden": 1
    },
    {
      "fieldname": "theme_name",
      "fieldtype": "Data",
      "label": "Theme Name",
      "reqd": 1,
      "unique": 0,
      "description": "A friendly name for this theme (e.g., 'My Brand Theme', 'Summer Campaign')",
      "in_list_view": 1
    },
    {
      "fieldname": "business",
      "fieldtype": "Link",
      "label": "Business",
      "options": "Business",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "section_look",
      "fieldtype": "Section Break",
      "label": "Look & Feel"
    },
    {
      "fieldname": "template",
      "fieldtype": "Select",
      "label": "Template (Layout)",
      "reqd": 1,
      "default": "Modern",
      "options": "Modern\nProfessional\nMinimal\nClassic",
      "in_list_view": 1,
      "description": "Controls the page structure and layout"
    },
    {
      "fieldname": "column_break_look",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "color_scheme",
      "fieldtype": "Select",
      "label": "Color Scheme",
      "reqd": 1,
      "default": "Blue",
      "options": "Violet\nIndigo\nBlue\nGreen\nYellow\nOrange\nRed\nCustom",
      "in_list_view": 1,
      "description": "Select a preset or 'Custom' to choose your own colors"
    },
    {
      "fieldname": "section_colors",
      "fieldtype": "Section Break",
      "label": "Colors",
      "hidden": 0
    },
    {
      "fieldname": "primary_color",
      "fieldtype": "Color",
      "label": "Primary Color",
      "reqd": 1,
      "default": "#2563EB",
      "in_list_view": 1,
      "description": "Main brand color used in headers, buttons, links"
    },
    {
      "fieldname": "secondary_color",
      "fieldtype": "Color",
      "label": "Secondary Color",
      "reqd": 1,
      "default": "#FFFFFF",
      "in_list_view": 1,
      "description": "Background or text inverse color"
    },
    {
      "fieldname": "accent_color",
      "fieldtype": "Color",
      "label": "Accent Color",
      "default": "#60A5FA",
      "description": "Highlights, hover states, borders"
    },
    {
      "fieldname": "section_style",
      "fieldtype": "Section Break",
      "label": "Style Settings"
    },
    {
      "fieldname": "button_style",
      "fieldtype": "Select",
      "label": "Button Style",
      "reqd": 1,
      "default": "Filled",
      "options": "Filled\nOutline\nRounded\nPill",
      "in_list_view": 1
    },
    {
      "fieldname": "card_style",
      "fieldtype": "Select",
      "label": "Card Style",
      "reqd": 1,
      "default": "Modern",
      "options": "Modern\nProfessional\nMinimal\nClassic",
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_style",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "font_family",
      "fieldtype": "Data",
      "label": "Font Family",
      "description": "Custom font family name (e.g., 'Roboto', 'Open Sans')"
    },
    {
      "fieldname": "section_advanced",
      "fieldtype": "Section Break",
      "label": "Advanced Settings",
      "collapsible": 1
    },
    {
      "fieldname": "custom_settings",
      "fieldtype": "Code",
      "label": "Custom Settings",
      "options": "JSON",
      "description": "JSON configuration for advanced theme customization"
    },
    {
      "fieldname": "section_activation",
      "fieldtype": "Section Break",
      "label": "Activation"
    },
    {
      "fieldname": "active",
      "fieldtype": "Check",
      "label": "Active",
      "default": 0,
      "in_list_view": 1,
      "description": "Only one theme can be active per business"
    }
  ],
  "permissions": [
    {
      "role": "OSDuo Business Owner",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    },
    {
      "role": "OSDuo Business Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    },
    {
      "role": "OSDuo Marketing Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 0,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 0
    },
    {
      "role": "OSDuo System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "user_permission": 1
    }
  ]
}
